# Copia este archivo como .env.local y completa los valores (no subas el .env real).
# URL base del API: output `ApiUrl` de `sam deploy`, sin barra final.
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
# Opcional: debe coincidir con el parámetro MaxOrderItems del backend (por defecto 100).
VITE_MAX_ORDER_ITEMS=100
